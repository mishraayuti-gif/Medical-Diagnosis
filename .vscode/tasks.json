		},
		{
			"label": "Start All MediGrid Services",
			"type": "shell",
			"command": "python scripts/run_all.py",
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run MediGrid services directly",
			"type": "shell",
			"command": "python",
			"args": [
				"scripts/run_all.py"
			],
			"isBackground": true,
			"group": "build"
